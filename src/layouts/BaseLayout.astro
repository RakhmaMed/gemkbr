---
interface Props {
	title?: string;
	description?: string;
	canonicalPath?: string;
}

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://gemkbr.ru';
const {
	title = 'GemKBR — изделия ручной работы',
	description = 'Магазин изделий ручной работы и 3D-конструктор браслетов GemKBR.',
	canonicalPath = Astro.url.pathname,
} = Astro.props;
const canonical = new URL(canonicalPath, siteUrl).toString();
---

<!doctype html>
<html lang="ru">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="GemKBR" />
		<slot name="head" />
		<link rel="stylesheet" href="/styles/global.css" />
		<link
			rel="preconnect"
			href="https://fonts.googleapis.com"
		/>
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700&family=Manrope:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<header class="site-header">
			<a class="brand" href="/">GemKBR</a>
			<nav class="nav" aria-label="Основная навигация">
				<a href="/catalog">Каталог</a>
				<a href="/designer/bracelet">Конструктор</a>
				<a href="/cart">Корзина</a>
				<a href="/account">Аккаунт</a>
			</nav>
		</header>
		<main>
			<slot />
		</main>
		<footer class="site-footer">
			<p>© {new Date().getFullYear()} GemKBR</p>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		--bg: #f3efe6;
		--bg-deep: #e4d8c4;
		--ink: #1c1914;
		--ink-muted: #5c5348;
		--accent: #0f5c4c;
		--accent-soft: #d7ebe4;
		--line: #cfc3b0;
		--surface: rgba(255, 252, 246, 0.82);
		--font-display: "Fraunces", "Iowan Old Style", "Palatino Linotype", Palatino, serif;
		--font-body: "Manrope", "Segoe UI", sans-serif;
	}

	* {
		box-sizing: border-box;
	}

	html,
	body {
		margin: 0;
		min-height: 100%;
		color: var(--ink);
		font-family: var(--font-body);
		background:
			radial-gradient(circle at 12% 18%, rgba(15, 92, 76, 0.12), transparent 40%),
			radial-gradient(circle at 88% 0%, rgba(166, 94, 46, 0.14), transparent 36%),
			linear-gradient(160deg, var(--bg), var(--bg-deep));
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	.site-header,
	.site-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 1rem 1.25rem;
	}

	.brand {
		font-family: var(--font-display);
		font-size: clamp(1.6rem, 4vw, 2.2rem);
		letter-spacing: 0.02em;
	}

	.nav {
		display: flex;
		flex-wrap: wrap;
		gap: 0.85rem;
		font-size: 0.95rem;
	}

	.nav a:hover {
		color: var(--accent);
	}

	main {
		min-height: 70vh;
		padding: 0 1.25rem 3rem;
	}

	.site-footer {
		border-top: 1px solid var(--line);
		color: var(--ink-muted);
		font-size: 0.9rem;
	}
</style>
