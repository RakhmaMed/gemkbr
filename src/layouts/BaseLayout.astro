---
interface Props {
	title?: string;
	description?: string;
	canonicalPath?: string;
}

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://gemkbr.ru';
const {
	title = 'GemKBR — изделия ручной работы',
	description = 'Магазин изделий ручной работы и 3D-конструктор браслетов GemKBR.',
	canonicalPath = Astro.url.pathname,
} = Astro.props;
const canonical = new URL(canonicalPath, siteUrl).toString();
const pathname = Astro.url.pathname;

function navCurrent(href: string, matchPrefix?: string): 'page' | undefined {
	const prefix = matchPrefix ?? href;
	if (pathname === href || pathname.startsWith(`${prefix}/`)) return 'page';
	return undefined;
}
---

<!doctype html>
<html lang="ru">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="GemKBR" />
		<slot name="head" />
		<link rel="stylesheet" href="/styles/global.css" />
		<link
			rel="preconnect"
			href="https://fonts.googleapis.com"
		/>
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700&family=Manrope:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<header class="site-header">
			<a class="brand" href="/">GemKBR</a>
			<nav class="nav" aria-label="Основная навигация">
				<a href="/catalog" aria-current={navCurrent('/catalog')}>Каталог</a>
				<a href="/designer/bracelet" aria-current={navCurrent('/designer/bracelet', '/designer')}>Конструктор</a>
				<a href="/cart" aria-current={navCurrent('/cart')}>Корзина</a>
				<a href="/account" aria-current={navCurrent('/account')}>Аккаунт</a>
			</nav>
		</header>
		<main>
			<slot />
		</main>
		<footer class="site-footer">
			<p>© {new Date().getFullYear()} GemKBR</p>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		--bg: #f3efe6;
		--bg-deep: #e4d8c4;
		--ink: #1c1914;
		--ink-muted: #5c5348;
		--accent: #0f5c4c;
		--accent-soft: #d7ebe4;
		--line: #cfc3b0;
		--surface: #fffcf6;
		--font-display: "Fraunces", "Iowan Old Style", "Palatino Linotype", Palatino, serif;
		--font-body: "Manrope", "Segoe UI", sans-serif;
		--chrome-offset: 5.5rem;
		--mobile-nav-height: 0px;
	}

	* {
		box-sizing: border-box;
	}

	html,
	body {
		margin: 0;
		min-height: 100%;
		color: var(--ink);
		font-family: var(--font-body);
		background:
			radial-gradient(circle at 12% 18%, rgba(15, 92, 76, 0.12), transparent 40%),
			radial-gradient(circle at 88% 0%, rgba(166, 94, 46, 0.14), transparent 36%),
			linear-gradient(160deg, var(--bg), var(--bg-deep));
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	.site-header,
	.site-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 1rem clamp(1rem, 3vw, 1.75rem);
	}

	.site-header {
		position: sticky;
		top: 0;
		z-index: 20;
		/* Opaque surface — backdrop-filter flickers on Firefox tab restore */
		background: color-mix(in srgb, var(--bg) 94%, #fff);
		border-bottom: 1px solid color-mix(in srgb, var(--line) 55%, transparent);
	}

	.brand {
		font-family: var(--font-display);
		font-size: clamp(1.45rem, 3.5vw, 2rem);
		letter-spacing: 0.02em;
		line-height: 1;
		flex-shrink: 0;
	}

	.nav {
		display: flex;
		flex-wrap: nowrap;
		align-items: center;
		justify-content: flex-end;
		gap: clamp(0.65rem, 2vw, 1.1rem);
		font-size: 0.95rem;
		line-height: 1.2;
	}

	.nav a {
		white-space: nowrap;
	}

	.nav a:hover {
		color: var(--accent);
	}

	.nav a[aria-current='page'] {
		color: var(--accent);
		font-weight: 600;
	}

	main {
		min-height: 70vh;
		padding: 0 clamp(1rem, 3vw, 1.75rem) 3rem;
	}

	.site-footer {
		border-top: 1px solid var(--line);
		color: var(--ink-muted);
		font-size: 0.9rem;
	}

	@media (max-width: 640px) {
		:root {
			--chrome-offset: 0px;
			--mobile-nav-height: calc(3.35rem + env(safe-area-inset-bottom, 0px));
		}

		/* Keep bottom nav; hide top chrome so it takes no vertical space */
		.site-header {
			position: static;
			display: block;
			height: 0;
			margin: 0;
			padding: 0;
			overflow: visible;
			border: 0;
			background: transparent;
		}

		.brand {
			display: none;
		}

		.nav {
			position: fixed;
			bottom: 0;
			left: 0;
			right: 0;
			z-index: 30;
			display: grid;
			grid-template-columns: repeat(4, minmax(0, 1fr));
			justify-content: stretch;
			width: 100%;
			gap: 0;
			margin: 0;
			padding: 0.4rem 0.25rem calc(0.4rem + env(safe-area-inset-bottom, 0px));
			font-size: 0.78rem;
			text-align: center;
			background: color-mix(in srgb, var(--bg) 96%, #fff);
			border-top: 1px solid var(--line);
			box-shadow: 0 -4px 18px rgba(28, 25, 20, 0.06);
		}

		.nav a {
			display: flex;
			align-items: center;
			justify-content: center;
			min-height: 2.55rem;
			padding: 0.35rem 0.2rem;
			border-radius: 0.55rem;
		}

		.nav a[aria-current='page'] {
			background: var(--accent-soft);
		}

		main {
			padding: 0.4rem 0.45rem calc(0.35rem + var(--mobile-nav-height));
		}

		.site-footer {
			padding: 0.85rem 0.75rem calc(0.85rem + var(--mobile-nav-height));
		}
	}
</style>
