---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { createServices } from '../../server/container';
import { formatRub } from '../../lib/money';

const { catalog } = createServices();
const products = await catalog.listActiveProducts();
---

<BaseLayout title="Каталог — GemKBR" description="Готовые изделия ручной работы GemKBR">
	<section class="stack catalog">
		<header class="catalog-intro">
			<h1>Каталог</h1>
			<p class="muted">Готовые изделия. Для сборки своего браслета откройте конструктор.</p>
		</header>
		<div class="grid-products">
			{
				products.map((product) => {
					const price = product.variants[0]?.priceMinor ?? 0;
					return (
						<article class="product-card">
							<a href={`/products/${product.slug}`}>
								{product.imageUrl ? (
									<span class="product-card-media">
										<img
											class="product-card-image"
											src={product.imageUrl}
											alt={product.name}
											width="512"
											height="512"
											loading="lazy"
										/>
									</span>
								) : null}
								<span class="product-card-body">
									<h2>{product.name}</h2>
									<p class="muted">{product.description}</p>
									<p class="product-card-price">{formatRub(price)}</p>
								</span>
							</a>
						</article>
					);
				})
			}
		</div>
		<p><a class="btn" href="/designer/bracelet">Собрать браслет</a></p>
	</section>
</BaseLayout>
