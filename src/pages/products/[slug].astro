---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { createServices } from '../../server/container';
import { formatRub } from '../../lib/money';
import AddToCartButton from '../../components/svelte/AddToCartButton.svelte';

const { slug } = Astro.params;
const { catalog } = createServices();
const product = slug ? await catalog.getProductBySlug(slug) : null;

if (!product) {
	return Astro.redirect('/catalog');
}

const variant = product.variants[0];
const siteUrl = Astro.site?.href?.replace(/\/$/, '') ?? '';
const imageAbs = product.imageUrl
	? product.imageUrl.startsWith('http')
		? product.imageUrl
		: `${siteUrl}${product.imageUrl}`
	: undefined;
---

<BaseLayout title={`${product.name} — GemKBR`} description={product.description}>
	<article class="stack product-detail" style="max-width: 42rem;">
		<a class="muted" href="/catalog">← Каталог</a>
		{
			product.imageUrl ? (
				<img
					class="product-detail-image"
					src={product.imageUrl}
					alt={product.name}
					width="1024"
					height="1024"
				/>
			) : null
		}
		<h1 style="font-family: var(--font-display); font-size: clamp(2rem, 6vw, 3.2rem); margin: 0;">
			{product.name}
		</h1>
		<p>{product.description}</p>
		{
			variant && (
				<>
					<p style="font-size: 1.4rem; font-weight: 600;">{formatRub(variant.priceMinor)}</p>
					<AddToCartButton client:load productVariantId={variant.id} />
				</>
			)
		}
	</article>

	<script type="application/ld+json" set:html={JSON.stringify({
		'@context': 'https://schema.org',
		'@type': 'Product',
		name: product.name,
		description: product.description,
		image: imageAbs,
		offers: variant
			? {
					'@type': 'Offer',
					priceCurrency: 'RUB',
					price: (variant.priceMinor / 100).toFixed(2),
					availability: 'https://schema.org/InStock',
				}
			: undefined,
	})} />
</BaseLayout>
