---
import BaseLayout from '../layouts/BaseLayout.astro';

const beads = [
	{ src: 'madagascar-rose-quartz.webp', alt: 'Мадагаскарский розовый кварц' },
	{ src: 'citrine.webp', alt: 'Цитрин' },
	{ src: 'uruguay-amethyst.webp', alt: 'Уругвайский аметист' },
	{ src: 'clear-quartz.webp', alt: 'Горный хрусталь' },
	{ src: 'blue-moonstone.webp', alt: 'Голубой лунный камень' },
	{ src: 'gold-tiger-eye.webp', alt: 'Золотой тигровый глаз' },
	{ src: 'prehnite.webp', alt: 'Пренит' },
	{ src: 'white-moonstone.webp', alt: 'Белый лунный камень' },
	{ src: 'bolivian-amethyst.webp', alt: 'Боливийский аметист' },
	{ src: 'yellow-tiger-eye.webp', alt: 'Жёлтый тигровый глаз' },
	{ src: 'red-fire-quartz.webp', alt: 'Красный огненный кварц' },
	{ src: 'hetian-white-jade.webp', alt: 'Хотанский белый нефрит' },
] as const;
---

<BaseLayout title="GemKBR — изделия ручной работы">
	<section class="hero" aria-label="GemKBR">
		<div class="hero-visual" aria-hidden="true">
			{
				beads.map((bead, i) => (
					<img
						class={`hero-bead hero-bead--${i + 1}`}
						src={`/catalog/crystal-single-1019/${bead.src}`}
						alt=""
						width="512"
						height="512"
						loading={i < 4 ? 'eager' : 'lazy'}
						decoding="async"
					/>
				))
			}
			<div class="hero-glow"></div>
		</div>

		<div class="hero-copy">
			<p class="hero-kicker">Изделия ручной работы</p>
			<h1>GemKBR</h1>
			<p class="hero-lead">
				Натуральные бусины, готовые украшения и 3D-конструктор браслетов.
			</p>
			<div class="hero-actions">
				<a class="btn" href="/designer/bracelet">Открыть конструктор</a>
				<a class="btn btn-ghost" href="/catalog">Смотреть каталог</a>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.hero {
		position: relative;
		display: grid;
		align-items: center;
		min-height: calc(100svh - 5.5rem);
		padding: 1.5rem 0 2.5rem;
		overflow: clip;
	}

	.hero-visual {
		position: absolute;
		inset: -6% -4% -10% 28%;
		pointer-events: none;
		z-index: 0;
	}

	.hero-glow {
		position: absolute;
		inset: 12% 6% 18% 12%;
		border-radius: 50%;
		background:
			radial-gradient(circle at 40% 45%, rgba(15, 92, 76, 0.2), transparent 64%),
			radial-gradient(circle at 72% 28%, rgba(196, 120, 72, 0.14), transparent 56%);
		filter: blur(10px);
		animation: hero-glow 10s ease-in-out infinite alternate;
	}

	.hero-bead {
		position: absolute;
		width: clamp(5rem, 12vw, 10rem);
		height: clamp(5rem, 12vw, 10rem);
		object-fit: cover;
		object-position: center;
		border-radius: 50%;
		clip-path: circle(50%);
		mix-blend-mode: lighten;
		filter: saturate(1.08) contrast(1.05) drop-shadow(0 14px 22px rgba(28, 25, 20, 0.16));
		opacity: 0;
		animation:
			hero-bead-in 0.9s ease forwards,
			hero-float 7.5s ease-in-out infinite;
	}

	.hero-bead--1 {
		top: 6%;
		left: 36%;
		width: clamp(7rem, 15vw, 12rem);
		height: clamp(7rem, 15vw, 12rem);
		animation-delay: 0.05s, 0.05s;
	}
	.hero-bead--2 {
		top: 14%;
		left: 58%;
		width: clamp(5.5rem, 12vw, 9.8rem);
		height: clamp(5.5rem, 12vw, 9.8rem);
		animation-delay: 0.12s, 0.45s;
	}
	.hero-bead--3 {
		top: 2%;
		left: 76%;
		width: clamp(4.6rem, 10vw, 8.2rem);
		height: clamp(4.6rem, 10vw, 8.2rem);
		animation-delay: 0.18s, 0.85s;
	}
	.hero-bead--4 {
		top: 34%;
		left: 74%;
		width: clamp(6rem, 13vw, 11rem);
		height: clamp(6rem, 13vw, 11rem);
		animation-delay: 0.24s, 1.15s;
	}
	.hero-bead--5 {
		top: 48%;
		left: 48%;
		width: clamp(7.2rem, 16vw, 13rem);
		height: clamp(7.2rem, 16vw, 13rem);
		animation-delay: 0.3s, 0.25s;
	}
	.hero-bead--6 {
		top: 56%;
		left: 24%;
		width: clamp(5.2rem, 11vw, 9.2rem);
		height: clamp(5.2rem, 11vw, 9.2rem);
		animation-delay: 0.36s, 1.45s;
	}
	.hero-bead--7 {
		top: 70%;
		left: 42%;
		width: clamp(5.6rem, 12vw, 10rem);
		height: clamp(5.6rem, 12vw, 10rem);
		animation-delay: 0.42s, 0.65s;
	}
	.hero-bead--8 {
		top: 26%;
		left: 18%;
		width: clamp(4.4rem, 9vw, 7.6rem);
		height: clamp(4.4rem, 9vw, 7.6rem);
		animation-delay: 0.48s, 1.75s;
	}
	.hero-bead--9 {
		top: 42%;
		left: 88%;
		width: clamp(4rem, 9vw, 7.2rem);
		height: clamp(4rem, 9vw, 7.2rem);
		animation-delay: 0.54s, 0.95s;
	}
	.hero-bead--10 {
		top: 76%;
		left: 64%;
		width: clamp(4.8rem, 10vw, 8.4rem);
		height: clamp(4.8rem, 10vw, 8.4rem);
		animation-delay: 0.6s, 1.35s;
	}
	.hero-bead--11 {
		top: 10%;
		left: 8%;
		width: clamp(3.8rem, 8vw, 6.6rem);
		height: clamp(3.8rem, 8vw, 6.6rem);
		animation-delay: 0.66s, 1.95s;
	}
	.hero-bead--12 {
		top: 64%;
		left: 8%;
		width: clamp(3.6rem, 8vw, 6.4rem);
		height: clamp(3.6rem, 8vw, 6.4rem);
		animation-delay: 0.72s, 0.35s;
	}

	.hero-copy {
		position: relative;
		z-index: 1;
		display: grid;
		gap: 1rem;
		max-width: 34rem;
		opacity: 0;
		transform: translateY(1.1rem);
		animation: hero-copy-in 0.85s cubic-bezier(0.22, 1, 0.36, 1) 0.1s forwards;
	}

	.hero-kicker {
		margin: 0;
		color: var(--ink-muted);
		font-size: 0.92rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.hero h1 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(3.4rem, 11vw, 6.6rem);
		line-height: 0.92;
		letter-spacing: -0.02em;
	}

	.hero-lead {
		margin: 0;
		max-width: 28rem;
		color: var(--ink-muted);
		font-size: clamp(1.05rem, 2.2vw, 1.25rem);
		line-height: 1.45;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		padding-top: 0.35rem;
	}

	@keyframes hero-copy-in {
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes hero-bead-in {
		from {
			opacity: 0;
			transform: scale(0.84);
		}
		to {
			opacity: 0.98;
			transform: scale(1);
		}
	}

	@keyframes hero-float {
		0%,
		100% {
			translate: 0 0;
		}
		50% {
			translate: 0 -8px;
		}
	}

	@keyframes hero-glow {
		from {
			opacity: 0.7;
			transform: scale(0.97);
		}
		to {
			opacity: 1;
			transform: scale(1.04);
		}
	}

	@media (max-width: 820px) {
		.hero {
			align-items: end;
			min-height: calc(100svh - 6.5rem);
			padding: 0.75rem 0 2rem;
			gap: 0;
		}

		.hero-visual {
			inset: -2% -20% 26% -18%;
			-webkit-mask-image: linear-gradient(
				to bottom,
				#000 0%,
				#000 40%,
				rgba(0, 0, 0, 0.55) 68%,
				rgba(0, 0, 0, 0.15) 88%,
				transparent 100%
			);
			mask-image: linear-gradient(
				to bottom,
				#000 0%,
				#000 40%,
				rgba(0, 0, 0, 0.55) 68%,
				rgba(0, 0, 0, 0.15) 88%,
				transparent 100%
			);
		}

		.hero-bead {
			width: clamp(4rem, 20vw, 7rem);
			height: clamp(4rem, 20vw, 7rem);
			opacity: 0;
		}

		.hero-bead--1,
		.hero-bead--5 {
			width: clamp(5rem, 24vw, 8rem);
			height: clamp(5rem, 24vw, 8rem);
		}

		.hero-copy {
			max-width: 100%;
			gap: 0.85rem;
		}

		.hero-actions {
			flex-direction: column;
			align-items: stretch;
			padding-top: 0.15rem;
		}

		.hero-actions .btn {
			width: 100%;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-copy,
		.hero-bead,
		.hero-glow {
			animation: none !important;
			opacity: 1;
			transform: none;
			translate: none;
		}
	}
</style>
