---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="GemKBR — изделия ручной работы">
	<section class="hero">
		<div>
			<p class="muted">Изделия ручной работы · gemkbr.ru</p>
			<h1>GemKBR</h1>
			<p>
				Готовые браслеты, сумки и украшения — или соберите свой браслет в 3D-конструкторе из
				натуральных бусин, спейсеров и шармов.
			</p>
			<div class="hero-actions">
				<a class="btn" href="/designer/bracelet">Открыть конструктор</a>
				<a class="btn btn-ghost" href="/catalog">Смотреть каталог</a>
			</div>
		</div>
	</section>
</BaseLayout>
